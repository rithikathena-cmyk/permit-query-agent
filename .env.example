# Copy this file to .env and fill in your database credentials.
#
# Two supported targets:
#   * Local MySQL       — DB_HOST=localhost, DB_PORT=3306, DB_SSL unset.
#   * Aiven for MySQL    — the service host/port below, DB_SSL=true + CA cert.
#
# --- Aiven for MySQL (managed, TLS required) ---
# Copy these from the service's "Connection information" in the Aiven console.
# Aiven assigns a random high port (NOT 3306) and a default database `defaultdb`.
# Create a `permit_system` database in the console (Databases tab) and use it.
DB_HOST=mysql-xxxxxxxx-yyyy.aivencloud.com
DB_PORT=12345
DB_NAME=permit_system

# TLS: leave unset for local MySQL; set to true for Aiven (required). Download
# the CA certificate ("ca.pem") from the Aiven service overview and point
# DB_SSL_CA at it so the server certificate is verified.
DB_SSL=true
DB_SSL_CA=./certs/aiven-ca.pem

# App / MCP server credentials — use a LEAST-PRIVILEGE, read-only user so a
# guard bypass can never read other schemas or write. Create it with:
#   RO_DB_PASSWORD=your_ro_password python -m scripts.create_readonly_user
DB_USER=permit_ro
DB_PASSWORD=your_ro_password_here

# Admin credentials — used ONLY by setup scripts (create_readonly_user,
# init_db, seed_data). The app never uses these. On Aiven the admin user is
# `avnadmin` (its password is in the console's connection information).
DB_ADMIN_USER=avnadmin
DB_ADMIN_PASSWORD=your_avnadmin_password_here
