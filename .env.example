# Copy this file to .env and fill in your MySQL credentials.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=permit_system

# App / MCP server credentials — use a LEAST-PRIVILEGE, read-only user so a
# guard bypass can never read other schemas or write. Create it with:
#   RO_DB_PASSWORD=your_ro_password python -m scripts.create_readonly_user
DB_USER=permit_ro
DB_PASSWORD=your_ro_password_here

# Admin credentials — used ONLY by setup scripts (create_readonly_user,
# init_db, seed_data). The app never uses these. Omit them in a deployment
# that only ever runs the app.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your_admin_password_here
