# Streamlit secrets template — SAFE TO COMMIT (placeholders only).
#
# Local dev: you do NOT need this file — the app reads ./.env instead.
# Cloud: copy these keys into your app's Secrets (Manage app -> Settings ->
# Secrets) on share.streamlit.io and fill in the REAL values THERE.
# The UI bridges every key here into the process environment before the
# backend loads, so the same names the .env uses work unchanged.
#
# NEVER put a real key or password in this .example file — it is committed to
# the repo. Real secrets go only in .streamlit/secrets.toml (git-ignored) or
# the Cloud Secrets box.

# --- Database (a HOSTED MySQL-compatible DB the cloud can reach; NOT localhost) ---
# Example for TiDB Cloud (MySQL-compatible, port 4000, TLS required):
DATABASE_URL = "mysql+pymysql://USER.root:YOUR_DB_PASSWORD@gateway01.<region>.prod.aws.tidbcloud.com:4000/permit_system"

# TLS: required by hosted providers like TiDB Cloud. Enabling this makes the
# connection verify the server certificate against the system CA bundle.
DB_SSL = "true"
# If your provider ships its own CA bundle, point to it (TiDB usually doesn't
# need this since its cert chains to a public root):
# DB_SSL_CA = "/mount/src/permit-query-agent/certs/ca.pem"
# Only for a self-signed cert (not TiDB): DB_SSL_VERIFY = "false"

# --- Anthropic API ---
# Community Cloud has no `claude` CLI, so the agent uses the Anthropic API
# (billed per query). Put the REAL key in the Cloud Secrets box, not here.
ANTHROPIC_API_KEY = "sk-ant-..."
