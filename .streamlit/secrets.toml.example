# Streamlit secrets template — SAFE TO COMMIT (placeholders only).
#
# Local dev: you do NOT need this file — the app reads ./.env instead.
# Streamlit Cloud: copy these keys into your app's Secrets (Manage app ->
# Settings -> Secrets) on share.streamlit.io and fill in the REAL values THERE.
# The UI bridges every key here into the process environment before the backend
# loads, so the same names the .env uses work unchanged.
#
# NEVER put a real key or password in this .example file — it is committed to
# the repo. Real secrets go only in .streamlit/secrets.toml (git-ignored) or
# the Cloud Secrets box.

# --- Database: Aiven for MySQL (TLS required) ------------------------------- #
# Preferred: set the parts (no scheme gotchas). The app only READS, so point it
# at the least-privilege read-only user (permit_ro), NOT avnadmin.
DB_HOST = "permitquery-rithikdev1207-ed37.f.aivencloud.com"
DB_PORT = "15494"
DB_NAME = "defaultdb"
DB_USER = "permit_ro"
DB_PASSWORD = "YOUR_RO_PASSWORD"

# TLS: required by Aiven. Encrypts the connection; with no DB_SSL_CA the server
# cert is not verified (matches Aiven's ssl-mode=REQUIRED). To verify instead,
# commit the CA and set DB_SSL_CA = "./certs/aiven-ca.pem".
DB_SSL = "true"

# Alternative to the DB_* block above: a single URL pasted from Aiven. It is
# normalized automatically (mysql:// -> mysql+pymysql://, ssl-mode stripped and
# TLS switched on), so the raw provider URI works as-is. Use ONE approach.
# DATABASE_URL = "mysql://permit_ro:YOUR_RO_PASSWORD@permitquery-rithikdev1207-ed37.f.aivencloud.com:15494/defaultdb?ssl-mode=REQUIRED"

# --- Anthropic API ---------------------------------------------------------- #
# Streamlit Cloud has no `claude` CLI, so "Ask AI" uses the Anthropic API
# (billed per query). Put the REAL key in the Cloud Secrets box, not here.
ANTHROPIC_API_KEY = "sk-ant-..."

# Model for the API path (optional). Defaults to claude-sonnet-5.
CLAUDE_MODEL = "claude-opus-4-8"

# Seed sample data on first startup (optional). Only populates an EMPTY
# database — never clears existing rows — and needs write access, so the
# DATABASE_URL / DB_USER must be an admin (e.g. avnadmin) for this to do work.
# Leave unset once the database is seeded.
SEED_ON_START = "true"
