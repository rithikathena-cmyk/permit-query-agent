# Streamlit Cloud secrets template.
#
# Local dev: you do NOT need this file — the app reads ./.env instead.
# Cloud: copy these keys into your app's Secrets (Manage app -> Settings ->
# Secrets) on share.streamlit.io. The UI bridges every key here into the
# process environment before the backend loads, so the same names the .env
# uses work unchanged.
#
# Do NOT commit the real secrets.toml — it is git-ignored.

# --- Database (a HOSTED MySQL the cloud can reach; NOT localhost) ---
# Option A: a single connection URL (simplest for hosted MySQL)
# DATABASE_URL = "mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME"

# Option B: individual components
DB_HOST = "your-mysql-host.example.com"
DB_PORT = "3306"
DB_NAME = "permit_system"
DB_USER = "your_user"
DB_PASSWORD = "your_password"

# --- Agent (cloud has no `claude` CLI, so the API path is used) ---
ANTHROPIC_API_KEY = "sk-ant-..."
